FROM node:20-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ARG VITE_API_BASE_URL=""
ARG VITE_AZURE_AD_CLIENT_ID=""
ARG VITE_AZURE_AD_TENANT_ID=""
ARG VITE_AZURE_AD_AUTHORITY=""
ARG VITE_AZURE_AD_API_SCOPE=""
ARG VITE_AZURE_AD_TOKEN_MODE=""

ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_AZURE_AD_CLIENT_ID=$VITE_AZURE_AD_CLIENT_ID
ENV VITE_AZURE_AD_TENANT_ID=$VITE_AZURE_AD_TENANT_ID
ENV VITE_AZURE_AD_AUTHORITY=$VITE_AZURE_AD_AUTHORITY
ENV VITE_AZURE_AD_API_SCOPE=$VITE_AZURE_AD_API_SCOPE
ENV VITE_AZURE_AD_TOKEN_MODE=$VITE_AZURE_AD_TOKEN_MODE

RUN npm run build

FROM nginx:alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
